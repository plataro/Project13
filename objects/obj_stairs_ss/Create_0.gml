// ★ บันไดเฉียงฉากหลัง (side-scroll): (x, y) = ปลายล่าง ตรงระดับเท้า
// ยืนที่ปลายบันไดแล้วกด W = ก้าวขึ้นบันได, A/D = เดินขึ้นลง, S = ลงจากบันได, Space = กระโดดออก
// ตั้งใน Creation Code: dir = 1 (ขึ้นไปทางขวา) / -1 (ขึ้นไปทางซ้าย), run = ระยะแนวนอน, rise = ความสูง
dir = 1;
run = 256;
rise = 256;
depth = 60;   // อยู่หลังตัวละครและพื้น
top_x = x;
top_y = y;
inited = false;
