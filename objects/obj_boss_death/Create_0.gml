// ★ ฉากตายของบอส (สร้างจาก obj_enemy_boss Destroy) — placeholder วาดด้วยโค้ด
// 0-150 ดิ้น: สั่น วาบขาว/แดง ลำแสงพุ่งออก ระเบิดย่อยรอบตัว
// 150    ระเบิดใหญ่: จอขาว คลื่นกระแทก เศษกระจาย
// 150-330 ถ่านไฟลอย + ข้อความ "ปราบแล้ว"
t = 0;
t_burst = 150;
t_end = 330;
spr = -1;
img = 0;
xs = 1;
ys = 1;
col = c_white;
body_h = 120;
boss_name = "";
is_final = false;
booms = [];     // ระเบิดย่อย {x, y, r, l, l0}
shards = [];    // เศษ {x, y, vx, vy, rot, vr, s, l}
embers = [];    // ถ่านไฟ {x, y, vx, vy, l}
ring = 0;       // รัศมีคลื่นกระแทก
gui_flash = 0;
depth = -100000;   // ★ วาดทับทุกอย่างในฉาก (ตัวบอสหายไปแล้ว)

// ★ บอสสุดท้าย (ตั้งใน Step เฟรมแรก หลังรู้ว่า is_final)
inited = false;
rings = [];        // คลื่นกระแทกหลายวง {r, spd, a}
pillar = 0;        // เสาแสงพุ่งขึ้นฟ้า (0-1)
mini_bursts = [];  // เฟรมที่ระเบิดกลางทาง
t_text = 0;        // เฟรมที่ข้อความขึ้น
t_fade = 0;        // เฟรมที่เริ่มเฟดดำ
black = 0;         // ความมืดตอนจบ (บอสสุดท้าย)
