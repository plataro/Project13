// ★ ร่างศัตรูที่ตายแล้ว: ภาพนิ่งล้มลงด้านข้าง ค้างไว้สักพัก แล้วจางหาย
// (สร้างจาก obj_enemy Destroy ซึ่งตั้ง spr / dscale / flip / col ให้)
spr = -1;
dscale = 2;
flip = 1;
col = c_white;
t = 0;
fall_time = 14;    // ล้มลงใช้กี่เฟรม
hold = 90;         // ค้างร่างไว้กี่เฟรมหลังล้ม
fade = 40;         // จางหายกี่เฟรม
alpha = 1;
depth = -y + 30;   // อยู่ใต้ตัวที่ยังยืนอยู่ตรงนั้น (ร่างนอนกับพื้น)
