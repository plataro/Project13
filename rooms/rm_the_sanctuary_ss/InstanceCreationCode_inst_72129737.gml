items = [{ k: ["W"], c: [-4], t: L("ยืนที่ปลายบันไดแล้วกด W ขึ้นบันได", "Stand at the foot of the stairs and press W") }, { k: ["A","D"], c: [-5,-6], t: L("เดินขึ้น/ลงบันได (เดินสุดปลายเพื่อลง กด Space กระโดดได้)", "Walk up/down (walk off the end to leave, Space to jump)") }];
